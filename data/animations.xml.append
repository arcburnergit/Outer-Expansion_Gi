<!--Projectiles-->
<FTL>
<animSheet name="laser_bio_oe_left" w="60" h="30" fw="60" fh="30">projectiles/laser_bio_oe_left.png</animSheet>
<anim name="laser_bio_oe_left">
	<sheet>laser_bio_oe_left</sheet>
	<desc length="1" x="0" y="0" />
	<time>0.3</time>
</anim>
<animSheet name="laser_bio_oe_left" w="60" h="30" fw="60" fh="30">projectiles/laser_bio_oe_right.png</animSheet>
<anim name="laser_bio_oe_left">
	<sheet>laser_bio_oe_left</sheet>
	<desc length="1" x="0" y="0" />
	<time>0.3</time>
</anim>
</FTL>

