<?xml version="1.0" encoding="UTF-8"?>
<FTL>

<mod:findName name="STORAGE_CHECK_CREW_REAL">
	<mod-append:choice req="unique_oe_jay" blue="false" hidden="true">
		<text>Look for Jay.</text>
		<event load="SOCIALIZE_OE_JAY_LIST"/>
	</mod-append:choice>
</mod:findName>

<mod:findName type="event" name="COMBAT_CHECK_TOGGLE">
	<mod-append:choice req="OE_COMBAT_BIRD_BURST_1" blue="false">
		<text>(Amp Burst) Set the state of the drone. [Current power: 2].</text>
		<event load="COMBAT_CHECK_OE_BIRD_BURST_AMP_1" />
	</mod-append:choice>
	<mod-append:choice req="OE_COMBAT_BIRD_BURST_2" blue="false">
		<text>(Amp Burst) Set the state of the drone. [Current power: 3].</text>
		<event load="COMBAT_CHECK_OE_BIRD_BURST_AMP_2" />
	</mod-append:choice>
	<mod-append:choice req="OE_COMBAT_BIRD_BURST_3" blue="false">
		<text>(Amp Burst) Set the state of the drone. [Current power: 4].</text>
		<event load="COMBAT_CHECK_OE_BIRD_BURST_AMP_3" />
	</mod-append:choice>
	
	<mod-append:choice req="OE_COMBAT_BIRD_MULTI_1_LASER" blue="false">
		<text>(Twin Drone I) Set the state of the drone. [Current mode: Laser].</text>
		<event load="COMBAT_CHECK_OE_BIRD_MULTI_1_LASER" />
	</mod-append:choice>
	<mod-append:choice req="OE_COMBAT_BIRD_MULTI_1_BEAM" blue="false">
		<text>(Twin Drone I) Set the state of the drone. [Current mode: Beam].</text>
		<event load="COMBAT_CHECK_OE_BIRD_MULTI_1_BEAM" />
	</mod-append:choice>
	
	<mod-append:choice req="OE_COMBAT_BIRD_MULTI_2_LASER" blue="false">
		<text>(Twin Drone II) Set the state of the drone. [Current mode: Laser].</text>
		<event load="COMBAT_CHECK_OE_BIRD_MULTI_2_LASER" />
	</mod-append:choice>
	<mod-append:choice req="OE_COMBAT_BIRD_MULTI_2_BEAM" blue="false">
		<text>(Twin Drone II) Set the state of the drone. [Current mode: Beam].</text>
		<event load="COMBAT_CHECK_OE_BIRD_MULTI_2_BEAM" />
	</mod-append:choice>
	
	<mod-append:choice req="OE_COMBAT_BIRD_MULTI_2_LOOT_LASER" blue="false">
		<text>(Twin Drone II [GI LOOT]) Set the state of the drone. [Current mode: Laser].</text>
		<event load="COMBAT_CHECK_OE_BIRD_MULTI_2_LOOT_LASER" />
	</mod-append:choice>
	<mod-append:choice req="OE_COMBAT_BIRD_MULTI_2_LOOT_BEAM" blue="false">
		<text>(Twin Drone II [GI LOOT]) Set the state of the drone. [Current mode: Beam].</text>
		<event load="COMBAT_CHECK_OE_BIRD_MULTI_2_LOOT_BEAM" />
	</mod-append:choice>
</mod:findName>

<!--
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
					AMP BURST
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
-->	
<event name="COMBAT_CHECK_OE_BIRD_BURST_AMP_1">
	<text>What power do you want to set the drone to?
	Current stats; [projectiles: 2, speed 10].</text>
	<choice hidden="true">
		<text>Set the drone to 3 power. [projectiles: 3, speed: 8].</text>
		<event>
			<text>You start calibrating the drone...</text>
			<remove name="OE_COMBAT_BIRD_BURST_1" />
			<choice hidden="true">
				<text>Continue...</text>
				<event>
					<text>You finish calibrating the drone successfully.</text>
					<drone name="OE_COMBAT_BIRD_BURST_2" />
					<choice hidden="true">
						<text>Continue...</text>
						<event load="COMBAT_CHECK_TOGGLE_LOAD" />
					</choice>
				</event>
			</choice>
		</event>
	</choice>
	<choice hidden="true">
		<text>Set the drone to 4 power. [projectiles: 4, speed: 6].</text>
		<event>
			<text>You start calibrating the drone...</text>
			<remove name="OE_COMBAT_BIRD_BURST_1" />
			<choice hidden="true">
				<text>Continue...</text>
				<event>
					<text>You finish calibrating the drone successfully.</text>
					<drone name="OE_COMBAT_BIRD_BURST_3" />
					<choice hidden="true">
						<text>Continue...</text>
						<event load="COMBAT_CHECK_TOGGLE_LOAD" />
					</choice>
				</event>
			</choice>
		</event>
	</choice>
	<choice hidden="true">
		<text>Return to the toggle menu.</text>
		<event load="COMBAT_CHECK_TOGGLE_LOAD" />
	</choice>
</event>
