<store>
</store>

<mod:findLike type="achievements" limit="1" reverse="false">
	<mod:findLike type="page">
		<mod:findLike type="section">
			<mod:selector text="The Outer Cluster"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Unique Crew (OE)"/>
			<mod-append:achievement name="ACH_OE_CREW_JAY">
				<name>Repair Arms</name>
				<secretDescription>Help a master engineer with her auto-ship problem.</secretDescription>
				<description>Dismantle a large rebel auto-ship and recruit Jay.</description>
				<header>Character Recruited</header>
				<icon>ach_oe_crew_jay</icon>
				<variable name="ach_crew_oe_jay" amount="1"/>
				<sound>achievement</sound>
			</mod-append:achievement>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Loot Transports (OE)"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Renegade Cruisers (OE)"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Music (OE)"/>
			<mod-append:achievement name="MUSIC_OE_BIRD">
				<name>Gi</name>
				<description id="jukebox_unlocked" />
				<secretDescription id="jukebox_locked" />
				<header id="jukebox_header" />
				<icon>music_unlocked</icon>
				<variable name="juke_oe_bird" amount="1" />
				<multiDifficulty>false</multiDifficulty>
			</mod-append:achievement>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Thest's Boons (OE)"/>
			<mod-append:achievement name="ACH_BOON_OE_BIRD">
				<name>Boon of Feathers</name>
				<secretDescription>Receive the Boon of Feathers from Thest.</secretDescription>
				<description>Show a Gi crew to Thest. 
				While in effect; Gi crew gain an additional 0.25x to their auto repair speed.</description>
				<header>Boon Received</header>
				<icon>ach_boon_oe_bird</icon>
				<multiDifficulty>false</multiDifficulty>
			</mod-append:achievement>
		</mod:findLike>
	</mod:findLike>
</mod:findLike>
</FTL>