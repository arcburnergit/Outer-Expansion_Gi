<FTL>
<mod:findLike type="scripts" limit="1" reverse="false">
  <mod-append:script>data/oe_scripts/core_bird.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/bird_drones.lua</mod-append:script>
</mod:findLike>

<mod:findLike type="ships" limit="1" reverse="false">
	<mod:findLike type="shipOrder">
		<mod:setAttributes oe_has_half="false"/>
	</mod:findLike>
	<mod:findWithChildLike type="shipOrder" child-type="empty">
		<mod:selector oe="true"/>
		<mod:setAttributes oe_has_half="true"/>
	</mod:findWithChildLike>
	<mod:findLike type="shipOrder">
		<mod:selector oe_has_half="true"/>
		<mod:findLike type="empty">
			<mod:selector oe="true"/>
			<mod:removeTag/>
		</mod:findLike>
		<mod-append:empty/>
		<mod-append:empty/>
		<mod-append:empty/>
		<mod-append:empty/>
		
		<mod-append:empty/>
		<mod-append:empty/>
		<mod:removeAttributes oe_has_half="" />
	</mod:findLike>
	<mod:findLike type="shipOrder">
		<mod:selector oe_has_half="false"/>
		<mod-append:empty/>
		<mod-append:empty/>
		<mod-append:empty/>
		<mod-append:empty/>
		
		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>

		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>
		<mod:removeAttributes oe_has_half="" />
	</mod:findLike>
</mod:findLike>

<mod:findLike type="crew" limit="1" reverse="false">
	<mod-append:race name="oe_bird">
		<maxHealth>80</maxHealth>
    	<moveSpeedMultiplier>2</moveSpeedMultiplier>
    	<repairSpeed>1</repairSpeed>
    	<animBase>human</animBase>
    	<deathSounds>
    		<deathSound>death1</deathSound>
    		<deathSound>death2</deathSound>
    	</deathSounds>
		<passiveStatBoosts>  
			<statBoost name="statBoost">
				<statBoost name="moveSpeedMultiplier">
                    <boostType>FLAT</boostType>
					<amount>-1</amount>
                    <shipTarget>CURRENT_ROOM</shipTarget>
                    <crewTarget>ENEMIES</crewTarget>
					<whiteList>
						<oe_bird />
					</whiteList>
					<maxStacks>1</maxStacks>
                </statBoost>
				<shipTarget>CURRENT_ROOM</shipTarget>
				<crewTarget>ENEMIES</crewTarget>
				<maxStacks>1</maxStacks>
			</statBoost>
		</passiveStatBoosts>
	</mod-append:race>
    <mod-append:race name="oe_bird_tech">
    	<maxHealth>100</maxHealth>
    	<moveSpeedMultiplier>2</moveSpeedMultiplier>
    	<repairSpeed>1</repairSpeed>
    	<animBase>human</animBase>
    	<deathSounds>
    		<deathSound>death1</deathSound>
    		<deathSound>death2</deathSound>
    	</deathSounds>
		<passiveStatBoosts>  
			<statBoost name="statBoost">
				<statBoost name="moveSpeedMultiplier">
                    <boostType>FLAT</boostType>
					<amount>-1</amount>
                    <shipTarget>CURRENT_ROOM</shipTarget>
                    <crewTarget>ENEMIES</crewTarget>
					<whiteList>
						<oe_bird_tech />
					</whiteList>
					<maxStacks>1</maxStacks>
                </statBoost>
				<shipTarget>CURRENT_ROOM</shipTarget>
				<crewTarget>ENEMIES</crewTarget>
				<maxStacks>1</maxStacks>
			</statBoost>
			<statBoost name="trueHealAmount">
				<boostType>FLAT</boostType>
				<amount>3</amount>
				<shipTarget>CURRENT_ROOM</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<droneTarget>DRONES</droneTarget>
				<priority>0</priority>
			</statBoost>
		</passiveStatBoosts>
    </mod-append:race>
	<mod-append:race name="unique_oe_jay">
    	<maxHealth>140</maxHealth>
    	<moveSpeedMultiplier>2</moveSpeedMultiplier>
    	<repairSpeed>1</repairSpeed>
    	<animBase>human</animBase>
    	<deathSounds>
    		<deathSound>death1</deathSound>
    		<deathSound>death2</deathSound>
    	</deathSounds>
		<passiveStatBoosts>  
			<statBoost name="statBoost">
				<statBoost name="moveSpeedMultiplier">
                    <boostType>FLAT</boostType>
					<amount>-1</amount>
                    <shipTarget>CURRENT_ROOM</shipTarget>
                    <crewTarget>ENEMIES</crewTarget>
					<whiteList>
						<unique_oe_jay />
					</whiteList>
					<maxStacks>1</maxStacks>
                </statBoost>
				<shipTarget>CURRENT_ROOM</shipTarget>
				<crewTarget>ENEMIES</crewTarget>
				<maxStacks>1</maxStacks>
			</statBoost>
			<statBoost name="trueHealAmount">
				<boostType>FLAT</boostType>
				<amount>3</amount>
				<shipTarget>CURRENT_ROOM</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<droneTarget>DRONES</droneTarget>
				<priority>0</priority>
			</statBoost>
		</passiveStatBoosts>
    </mod-append:race>
</mod:findLike>

<mod:findLike type="augments" limit="1" reverse="false">
	<mod-append:aug name="LAB_OE_BIRD_ESCAPESPEED">
    	<statBoosts>
			<statBoost name="statBoost">
				<statBoost name="moveSpeedMultiplier">
					<boostType>MULT</boostType>
					<amount>4</amount>
					<maxStacks>1</maxStacks>
					<shipTarget>CURRENT_ROOM</shipTarget>
					<crewTarget>ENEMIES</crewTarget>
					<droneTarget>CREW</droneTarget>
					<priority>999</priority>
					<whiteList load="LIST_CREW_AEA_BIRD" />
				</statBoost>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ENEMIES</crewTarget>
			</statBoost>
		</statBoosts>
	</mod-append:aug>
	<mod-append:aug name="LAB_OE_BIRD_AUTODESTROY">
    	<statBoosts>
			<statBoost name="statBoost">
				<statBoost name="trueHealAmount">
					<boostType>FLAT</boostType>
					<amount>-5</amount>
					<shipTarget>CURRENT_ROOM</shipTarget>
					<crewTarget>ENEMIES</crewTarget>
					<droneTarget>CREW</droneTarget>
					<priority>999</priority>
					<whiteList load="LIST_CREW_METAL" />
				</statBoost>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<whiteList load="LIST_CREW_AEA_BIRD" />
			</statBoost>
			<statBoost name="statBoost">
				<statBoost name="trueHealAmount">
					<boostType>FLAT</boostType>
					<amount>-5</amount>
					<shipTarget>CURRENT_ROOM</shipTarget>
					<crewTarget>ENEMIES</crewTarget>
					<droneTarget>DRONES</droneTarget>
					<priority>999</priority>
				</statBoost>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<whiteList load="LIST_CREW_AEA_BIRD" />
			</statBoost>
		</statBoosts>
	</mod-append:aug>
	<mod-append:aug name="LAB_OE_BIRD_SOCIAL">
    	<statBoosts>
			<statBoost name="statBoost">
				<statBoost name="repairSpeed">
					<boostType>FLAT</boostType>
					<amount>0.25</amount>
					<shipTarget>CURRENT_ROOM</shipTarget>
					<crewTarget>ALLIES</crewTarget>
					<affectsSelf>false</affectsSelf>
					<priority>0</priority>
					<whiteList load="LIST_CREW_AEA_BIRD" />
				</statBoost>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
			</statBoost>
			<statBoost name="statBoost">
				<statBoost name="damageMultiplier">
					<boostType>FLAT</boostType>
					<amount>0.1</amount>
					<shipTarget>CURRENT_ROOM</shipTarget>
					<crewTarget>ALLIES</crewTarget>
					<affectsSelf>false</affectsSelf>
					<priority>0</priority>
					<whiteList load="LIST_CREW_AEA_BIRD" />
				</statBoost>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
			</statBoost>
		</statBoosts>
	</mod-append:aug>
</mod:findLike>

<events>
	<variable name="ach_crew_oe_jay" op="set" val="0"/>
	<variable name="ach_trans_oe_bird" op="set" val="0" />
	<variable name="ach_ren_oe_bird" op="set" val="0"/>

	<variable name="sec_unique_oe_bird" op="set" val="0"/>
	<metaVariable name="juke_oe_bird" op="set" val="0" />

	<metaVariable name="prof_z_boon_oe_bird" op="set" val="0" />
	
  	<!--eventFile>special_oe_bird</eventFile-->
  	<!--eventFile>sector_oe_bird</eventFile-->
</events>

